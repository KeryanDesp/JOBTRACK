{
  "name": "jobtrack",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "dotenv -e .env -- pnpm --filter @jobtrack/api exec prisma migrate dev",
    "db:seed": "dotenv -e .env -- pnpm --filter @jobtrack/api exec prisma db seed",
    "db:studio": "dotenv -e .env -- pnpm --filter @jobtrack/api exec prisma studio",
    "postinstall": "pnpm --filter @jobtrack/api exec prisma generate --allow-no-models"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.126.0",
    "@fastify/cookie": "^9.4.0",
    "@fastify/helmet": "^11.1.0",
    "@fastify/multipart": "8.3.1",
    "@jobtrack/shared": "workspace:*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-fastify": "^10.4.0",
    "@prisma/client": "^5.20.0",
    "argon2": "^0.41.0",
    "dotenv": "^16.4.0",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.0",
    "mammoth": "1.12.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.25.12",
    "prettier": "^3.3.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  }
}
