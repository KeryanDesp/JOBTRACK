# --- Application ---
NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:5173

# --- Base de données ---
DATABASE_URL=postgresql://jobtrack:jobtrack@localhost:5432/jobtrack?schema=public

# --- Redis (sessions) ---
REDIS_URL=redis://localhost:6379

# --- Sessions ---
# Générer avec : openssl rand -base64 48
SESSION_SECRET=remplacer-par-un-secret-de-32-caracteres-minimum

# --- Google OAuth (tranche 1) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# --- Frontend ---
VITE_API_URL=http://localhost:3001/api/v1

# --- IA (tranche 2) ---
# Sans cette cle, le service d'extraction de CV est desactive (capabilities.ai = false).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Stockage ---
# Racine des fichiers stockes sur disque (CV importes). Jamais versionnee.
STORAGE_DIR=./storage

# --- France Travail — API Offres d'emploi v2 (tranche 3) ---
# Identifiants du partenaire cree sur https://francetravail.io. Sans eux, le
# connecteur est desactive : /jobs reste utilisable mais sans offre reelle.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# Defauts alignes sur la documentation officielle ; a ne changer qu'en cas
# d'evolution de l'API ou pour pointer vers un bac a sable de test.
FRANCE_TRAVAIL_API_URL=https://api.francetravail.io/partenaire/offresdemploi/v2
FRANCE_TRAVAIL_TOKEN_URL=https://entreprise.francetravail.fr/connexion/oauth2/access_token?realm=%2Fpartenaire
FRANCE_TRAVAIL_SCOPE=api_offresdemploiv2 o2dsoffre
